{
  "name": "utd-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plans a UT Dallas student's next semester from the official catalog and fills their Orion shopping cart.",
  "scripts": {
    "build:rules": "tsx scripts/build-rules.ts",
    "audit:demo": "tsx scripts/audit-demo.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "fetch:grades": "tsx scripts/fetch-grades.ts",
    "profs": "tsx scripts/profs-demo.ts",
